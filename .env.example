# .env.example
# Copy this file to .env and fill in your secure keys before deploying.

ADMIN_KEY=YourSuperSecretAdminPassword
USER_KEY=User
EMPLOYER_KEY=YourSuperSecretEmployerPassword
SECRET_KEY=A_Long_Random_String_For_Flask_Sessions

# Email Service (Set to 'local' for embedded mailbox, or 'smtp' for live dispatch)
MAIL_BACKEND=local
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=notifications@eprofile.local
